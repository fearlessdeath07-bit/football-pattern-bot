          ],
          "number": [
            { "name": "batchSize", "value": 1 }
          ]
        }
      },
      "id": "setConfig",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "url": "={{$json.apiBase}}/fixtures",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "date", "value": "={{$json.today}}" },
            { "name": "timezone", "value": "={{$json.timezone}}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-apisports-key", "value": "={{$json.apiKey}}" }
          ]
        },
        "options": { "response": { "response": { "fullResponse": false } } }
      },
      "id": "httpFixtures",
      "name": "HTTP - Today's Fixtures",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const allowed = new Set([39,78,79,61,135,140,203,204]); // EPL, Bundesliga, 2.Bundesliga, Ligue 1, Serie A, La Liga, Super Lig, 1. Lig\nconst resp = $json.response || [];\nconst fixtures = resp\n  .filter(r => allowed.has(r.league?.id))\n  .map(r => ({\n    fixtureId: r.fixture.id,\n    date: r.fixture.date,\n    leagueId: r.league.id,\n    leagueName: r.league.name,\n    country: r.league.country,\n    homeTeamId: r.teams.home.id,\n    homeTeam: r.teams.home.name,\n    awayTeamId: r.teams.away.id,\n    awayTeam: r.teams.away.name\n  }));\nreturn fixtures.map(f => ({json: f}));"
      },
      "id": "codeFilter",
      "name": "Code - Filter Target Leagues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": { "batchSize": 1 },
      "id": "splitFixtures",
      "name": "Split In Batches - Fixtures",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "url": "={{$item(0).$node['Set Config'].json.apiBase}}/fixtures",
        "sendQuery": true,
        "queryParameters": {
