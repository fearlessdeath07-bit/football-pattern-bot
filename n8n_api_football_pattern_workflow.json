      "id": "httpAwayGeneral",
      "name": "HTTP - Away Last5 League",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 260],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{$item(0).$node['Set Config'].json.apiBase}}/fixtures",
